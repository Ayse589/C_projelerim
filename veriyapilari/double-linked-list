#include<stdio.h>
#include<stdlib.h>

struct node {
	int data;
	struct node* next;
	struct node* prev;
};
struct node *createnode(int x) {
	struct node* yeni = (struct node*)malloc(sizeof(struct node));
	yeni->data = x;
	yeni->next = yeni->prev = NULL;
	return yeni;
}
void printlist(struct node* head) {
	struct node* temp = head;
	while (temp != NULL) {
		printf("%d\n", temp->data);
		temp = temp->next;
		printf("\n");
	}
}

void basaekle(struct node **head,int x) {
	
	struct node* yeni = createnode(x);
	yeni->next =*head;
(*head)->prev = yeni;
	*head = yeni;
}

void arayaekle(struct node* head, int x, int y) {
	struct node* yeni = createnode(x);
		
	struct node* temp = head;
	while (temp->data == y) {
		temp = temp->next;
	}
	yeni->next = temp->next;
	yeni->prev = temp;
	temp->next->prev = yeni;
	temp->next = yeni;
}
void sonaekle(struct node* head, int x) {
	struct node* yeni = createnode(x);
	struct node* temp = head;
	while (temp->next != NULL) {
		temp = temp->next;

	}
	yeni->prev = temp;
	temp->next = yeni;
}
void hesapla(struct node **head) {
	//Soru 4. Bir çift yönlü bağlı listedeki ilk düğümü silip bu düğümün değerini sona yeni düğüm
	//	olarak ekleyen “hesapla” isimli fonksiyonu yazınız.
	struct node* temp = *head;
	int yeni1 = temp->data;
	(*head) = temp->next;
	free(temp);

	struct node* yeni = (struct node*)malloc(sizeof(struct node));
	yeni->next = NULL;
	yeni->data = yeni1;
	temp = (*head);
	while (temp->next != NULL)
		temp = temp->next;
	temp->next = yeni;
	yeni->prev = temp;
}

void bastansil(struct node** head) {

	//Listenin ilk elemanı(head) silindiğinde, ilk elemandan sonraki düğüm yeni head olur.

	//	Adım Adım Yapılacaklar :

	//Geçici bir temp pointer'ı head'i göstersin(temp = list->head).

	//	head bir sonraki düğüme kaysın(list->head = list->head->next).

	//	Yeni head boş değilse(NULL değilse), onun prev pointer'ı NULL yapılır.

	//	Eğer liste tek elemanlıysa ve o silindiyse, yeni head NULL olur; bu durumda tail da NULL yapılır.

	//	free(temp) ile eski baş düğüm bellekten silinir.

	if (*head == NULL) {
		return;
	}


	struct node* temp = *head;
	(*head) = (*head)->next;
	if (*head != NULL)
		(*head)->prev = NULL;
	free(temp);
}

void aradansil(struct node** head, int x) {
	if (*head == NULL) {
		return;
	}
	struct node* temp = (*head);
	while (temp->data != x)
		temp = temp->next;
	temp->prev->next = temp->next;
	temp->next->prev = temp->prev;
	free(temp);
}

void sondansil(struct node **head) {
	if ((*head) == NULL) {
		return;
	}
	if ((*head)->next == *head) {
		free(*head);
		*head = NULL;
		return;
	}
	struct node* temp = *head;
	while (temp->next != NULL)
		temp = temp->next;
	temp->prev->next = NULL;
	free(temp);

}



